    /**
     * Recursively cleans a JsonNode. It removes any fields that are null, 
     * empty strings (""), empty arrays ([]), or empty objects ({}).
     */
    private com.fasterxml.jackson.databind.JsonNode cleanNode(com.fasterxml.jackson.databind.JsonNode node) {
        if (node == null || node.isNull()) return null;
        
        if (node.isObject()) {
            com.fasterxml.jackson.databind.node.ObjectNode obj = mapper.createObjectNode();
            node.fields().forEachRemaining(entry -> {
                com.fasterxml.jackson.databind.JsonNode cleaned = cleanNode(entry.getValue());
                if (cleaned != null) {
                    obj.set(entry.getKey(), cleaned);
                }
            });
            return obj.isEmpty() ? null : obj;
        } else if (node.isArray()) {
            com.fasterxml.jackson.databind.node.ArrayNode arr = mapper.createArrayNode();
            node.forEach(item -> {
                com.fasterxml.jackson.databind.JsonNode cleaned = cleanNode(item);
                if (cleaned != null) {
                    arr.add(cleaned);
                }
            });
            return arr.isEmpty() ? null : arr;
        } else if (node.isTextual()) {
            return node.asText().trim().isEmpty() ? null : node;
        }
        return node;
    }












