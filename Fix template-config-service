    private void compareField(String field, Object oldVal, Object newVal, Map<String, ValueDiff> diffs) {
        // Step 1: Check top-level blanks
        if (isBlank(oldVal) && isBlank(newVal)) return;
        
        // Step 2: Standard Java equals
        if (Objects.equals(oldVal, newVal)) return;

        // Step 3: Deep Structural JSON check using the cleaner
        try {
            com.fasterxml.jackson.databind.JsonNode oldNode = oldVal != null ? mapper.valueToTree(oldVal) : mapper.nullNode();
            com.fasterxml.jackson.databind.JsonNode newNode = newVal != null ? mapper.valueToTree(newVal) : mapper.nullNode();

            // Apply the deep cleaner to ignore nested nulls vs empty strings
            com.fasterxml.jackson.databind.JsonNode oldClean = cleanNode(oldNode);
            com.fasterxml.jackson.databind.JsonNode newClean = cleanNode(newNode);

            if (oldClean == null && newClean == null) return;
            if (oldClean != null && oldClean.equals(newClean)) return;
        } catch (Exception e) {
            // Silently fallback if Jackson parsing fails
        }

        // Step 4: Record actual difference
        diffs.put(field, new ValueDiff(oldVal, newVal));
    }
















