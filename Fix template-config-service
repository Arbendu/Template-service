
    // 1. Add this specific import at the top of your file if not already present
    import com.fasterxml.jackson.annotation.JsonInclude;
    import com.fasterxml.jackson.databind.JsonNode;
    import com.fasterxml.jackson.databind.ObjectMapper;

    // 2. Create a dedicated mapper that automatically strips nulls, "", [], and {}
    private static final ObjectMapper diffMapper = new ObjectMapper()
            .setSerializationInclusion(JsonInclude.Include.NON_EMPTY);

    // 3. Update your compareField method
    private void compareField(String field, Object oldVal, Object newVal, Map<String, ValueDiff> diffs) {
        // Step 1: Standard object equality (catches exact reference or exact primitive matches)
        if (Objects.equals(oldVal, newVal)) {
            return;
        }

        // Step 2: Deep JSON comparison ignoring empty/null fields natively via Jackson
        try {
            JsonNode oldNode = oldVal != null ? diffMapper.valueToTree(oldVal) : diffMapper.nullNode();
            JsonNode newNode = newVal != null ? diffMapper.valueToTree(newVal) : diffMapper.nullNode();

            // Treat totally empty nodes (like {} or []) as null to prevent false positives
            boolean oldIsEmpty = oldNode.isNull() || (oldNode.isContainerNode() && oldNode.isEmpty());
            boolean newIsEmpty = newNode.isNull() || (newNode.isContainerNode() && newNode.isEmpty());
            
            if (oldIsEmpty && newIsEmpty) {
                return;
            }

            // If the stripped JSON trees match perfectly, ignore the change!
            if (oldNode.equals(newNode)) {
                return;
            }
        } catch (Exception e) {
            // Silently fallback to recording the difference if Jackson serialization fails
        }

        // Step 3: Record the actual verified difference
        diffs.put(field, new ValueDiff(oldVal, newVal));
    }
