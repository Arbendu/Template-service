/**
 * CHANGED: previously bypassed all certificate validation (trust-all TrustManager),
 * flagged Critical by Fortify as "Insecure Transport" - it accepted ANY certificate,
 * making the connection vulnerable to man-in-the-middle attacks.
 * Fix: load the internal Druid server's self-signed cert into a proper truststore
 * and validate against that specific cert, instead of trusting everything.
 */
private HttpClient createSslConfiguredHttpClient() {
    try {
        // 1. Load the truststore containing the internal Druid server's certificate.
        //    Export the cert once (e.g. via `openssl s_client` or your browser) and
        //    import it: keytool -importcert -alias druid -file druid.crt -keystore druid-truststore.jks
        KeyStore trustStore = KeyStore.getInstance("JKS");
        try (InputStream trustStoreStream = getClass().getResourceAsStream("/druid-truststore.jks")) {
            trustStore.load(trustStoreStream, "changeit".toCharArray()); // use your real truststore password, ideally from a secret/env var
        }

        TrustManagerFactory trustManagerFactory =
                TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
        trustManagerFactory.init(trustStore);

        SSLContext sslContext = SSLContext.getInstance("TLS");
        sslContext.init(null, trustManagerFactory.getTrustManagers(), new SecureRandom());

        return HttpClient.newBuilder()
                .sslContext(sslContext)
                .build();

    } catch (NoSuchAlgorithmException | KeyManagementException | KeyStoreException
             | CertificateException | IOException e) {
        log.error("Fatal Error initializing Druid REST Client SSL Context", e);
        throw new IllegalStateException("Failed to configure secure transport layer for Druid client.", e);
    }
}












