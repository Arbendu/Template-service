                display: "flex",
                flexDirection: "column",
              }}
            >
              <Box
                sx={{
                  flexShrink: 0,
                  display: "flex",
                  bgcolor: "#f5f5f5",
                  borderBottom: "2px solid #e0e0e0",
                  overflow: "hidden",
                  position: "sticky",
                  top: 0,
                  zIndex: 100,
                }}
              >
                <Box
                  sx={{
                    width: 83,
                    minWidth: 80,
                    fontWeight: 600,
