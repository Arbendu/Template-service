            bgcolor: (theme) => alpha(theme.palette.warning.main, 0.1),
            width: 100,
            input: { fontWeight: "bold", color: "warning.main" },
          }}
        />
        <IconButton size="small" onClick={onRemove} color="error">
          <DeleteOutlineIcon fontSize="small" />
        </IconButton>
      </Box>
    );
  }

  // --- LOGIC NODES ---
  if (node.type === "BINARY_OP") {
    // 💡 FLATTENED LINEAR CANVAS: Operators site side-by-side seamlessly
    return (
      <Box display="inline-flex" alignItems="center" gap={1} flexWrap="wrap">
        <ExpressionNode
          node={node.left}
          availableVariables={availableVariables}
          onChange={(n) => onChange({ ...node, left: n })}
          onRemove={() => onChange({ ...node, left: createNode("EMPTY") })}
          setClipboard={setClipboard}
          clipboard={clipboard}
        />

        <Box
          display="inline-flex"
          alignItems="center"
          bgcolor="background.paper"
          borderRadius={1}
          border="1px solid"
          borderColor="divider"
        >
          <Select
            size="small"
            value={node.operator}
            onChange={(e) => onChange({ ...node, operator: e.target.value })}
            sx={{
              fontWeight: "bold",
              minWidth: 60,
              color: "text.primary",
              "& .MuiOutlinedInput-notchedOutline": { border: "none" },
            }}
          >
            {OPERATORS.map((o) => (
              <MenuItem key={o.id} value={o.id}>
                {o.label}
              </MenuItem>
            ))}
          </Select>
        </Box>

        <ExpressionNode
          node={node.right}
          availableVariables={availableVariables}
          onChange={(n) => onChange({ ...node, right: n })}
          onRemove={() => onChange({ ...node, right: createNode("EMPTY") })}
          setClipboard={setClipboard}
          clipboard={clipboard}
        />
      </Box>
    );
  }

  if (node.type === "FUNCTION") {
    const isKnownFunc = FUNCTIONS.find((f) => f.id === node.funcName);
    return (
      <BlockWrapper
        borderColor="secondary.main"
        title="Math Function"
        icon={FunctionsIcon}
      >
        <Box display="flex" flexWrap="wrap" alignItems="center" gap={1}>
          <Select
            size="small"
            value={isKnownFunc ? node.funcName : "CUSTOM"}
            onChange={(e) => onChange({ ...node, funcName: e.target.value })}
            sx={{
              bgcolor: (theme) => alpha(theme.palette.secondary.main, 0.1),
              color: "secondary.main",
              fontWeight: "bold",
            }}
          >
            {FUNCTIONS.map((f) => (
              <MenuItem key={f.id} value={f.id}>
                {f.label}
              </MenuItem>
            ))}
            {!isKnownFunc && (
              <MenuItem value="CUSTOM">{node.funcName}()</MenuItem>
            )}
          </Select>
          <Typography fontWeight="bold" color="secondary.main">
            (
          </Typography>
          <ExpressionNode
            node={node.arg}
            availableVariables={availableVariables}
            onChange={(n) => onChange({ ...node, arg: n })}
            onRemove={() => onChange({ ...node, arg: createNode("EMPTY") })}
            setClipboard={setClipboard}
            clipboard={clipboard}
          />
          <Typography fontWeight="bold" color="secondary.main">
            )
          </Typography>
        </Box>
      </BlockWrapper>
    );
  }

  if (node.type === "IF_ELSE") {
    return (
      <BlockWrapper
        borderColor="primary.main"
        title="Condition Rule"
        icon={AccountTreeIcon}
      >
        <Box display="flex" flexDirection="column" gap={2} pl={1}>
          <Box display="flex" alignItems="flex-start" gap={1}>
            <Chip
              label="IF"
              size="small"
              color="primary"
              sx={{ mt: 1, fontWeight: "bold" }}
            />
            <Box flex={1}>
              <ExpressionNode
                node={node.condition}
                availableVariables={availableVariables}
                onChange={(n) => onChange({ ...node, condition: n })}
                onRemove={() =>
                  onChange({ ...node, condition: createNode("EMPTY") })
                }
                setClipboard={setClipboard}
                clipboard={clipboard}
              />
            </Box>
          </Box>
          <Box
            display="flex"
            alignItems="flex-start"
            gap={1}
            sx={{ borderLeft: "2px solid", borderColor: "success.main", pl: 2 }}
          >
            <Chip
              label="THEN"
              size="small"
              color="success"
              sx={{ mt: 1, fontWeight: "bold" }}
            />
            <Box flex={1}>
              <ExpressionNode
                node={node.trueBranch}
                availableVariables={availableVariables}
                onChange={(n) => onChange({ ...node, trueBranch: n })}
                onRemove={() =>
                  onChange({ ...node, trueBranch: createNode("EMPTY") })
                }
                setClipboard={setClipboard}
                clipboard={clipboard}
              />
            </Box>
          </Box>
          <Box
            display="flex"
            alignItems="flex-start"
            gap={1}
            sx={{ borderLeft: "2px solid", borderColor: "error.main", pl: 2 }}
          >
            <Chip
              label="ELSE"
              size="small"
              color="error"
              sx={{ mt: 1, fontWeight: "bold" }}
            />
            <Box flex={1}>
              <ExpressionNode
                node={node.falseBranch}
                availableVariables={availableVariables}
                onChange={(n) => onChange({ ...node, falseBranch: n })}
                onRemove={() =>
                  onChange({ ...node, falseBranch: createNode("EMPTY") })
                }
                setClipboard={setClipboard}
                clipboard={clipboard}
              />
            </Box>
          </Box>
        </Box>
      </BlockWrapper>
    );
  }

  return null;
};

// ============================================================================
// MAIN APPLICATION COMPONENT
// ============================================================================
export default function AdvancedBidirectionalBuilder({
  initialExpression,
  availableVariables,
  onSave,
}) {
  const [rootNode, setRootNode] = useState(createNode("EMPTY"));
  const [clipboard, setClipboard] = useState(null);

  const jexlOutput = compileJexl(rootNode);
  const isComplete = !jexlOutput.includes("___");

  useEffect(() => {
    if (initialExpression) {
      try {
        const ast = parseJexlToAST(initialExpression);
        setRootNode(ast);
      } catch (err) {
        console.warn("Could not parse initial expression:", err);
      }
    }
  }, [initialExpression]);

  return (
    <Box sx={{ p: 3, bgcolor: "background.default", minHeight: "100%" }}>
      <Box
        sx={{ mx: "auto", display: "flex", flexDirection: "column", gap: 3 }}
      >
        {/* Header */}
        <Paper
          elevation={0}
          sx={{
            p: 3,
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            border: "1px solid",
            borderColor: "divider",
            bgcolor: "background.paper",
          }}
        >
          <Box>
            <Typography
              variant="h5"
              color="text.primary"
              fontWeight="bold"
              display="flex"
              alignItems="center"
              gap={1}
            >
              <CalculateIcon color="primary" /> Formula Builder
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Build rules visually to auto-generate the formula string.
            </Typography>
          </Box>
          <Box display="flex" gap={1.5}>
            <Button
              onClick={() => {
                setRootNode(createNode("EMPTY"));
                setClipboard(null);
              }}
              color="inherit"
              variant="outlined"
            >
              Reset Canvas
            </Button>
            <Button
              disabled={!isComplete || rootNode.type === "EMPTY"}
              onClick={() => onSave && onSave(jexlOutput)}
              variant="contained"
              color="primary"
              startIcon={<CheckCircleOutlineIcon />}
            >
              Save Formula
            </Button>
          </Box>
        </Paper>

        {/* CANVAS SECTION */}
        <Paper
          elevation={0}
          sx={{
            overflow: "hidden",
            border: "1px solid",
            borderColor: "divider",
          }}
        >
          <Box
            sx={{
              bgcolor: (theme) => alpha(theme.palette.text.primary, 0.05),
              p: 2,
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              borderBottom: "1px solid",
              borderColor: "divider",
            }}
          >
            <Typography
              variant="subtitle2"
              color="text.primary"
              fontWeight="bold"
              display="flex"
              alignItems="center"
              gap={1}
            >
              <AccountTreeIcon sx={{ color: "info.main" }} fontSize="small" />{" "}
              Visual Rule Canvas
            </Typography>
            {clipboard && (
              <Chip
                icon={<ContentCopyIcon fontSize="small" />}
                label="Block copied to clipboard"
                size="small"
                color="info"
                variant="outlined"
              />
            )}
          </Box>

          <Box
            sx={{
              p: 4,
              minHeight: 400,
              overflowX: "auto",
              bgcolor: "background.default",
            }}
          >
            {rootNode.type === "EMPTY" && (
              <Alert severity="info" icon={<ArrowForwardIcon />} sx={{ mb: 4 }}>
                <Typography variant="subtitle2" fontWeight="bold" mb={0.5}>
                  How to use the Visual Builder:
                </Typography>
                <Typography variant="body2" component="ul" sx={{ pl: 2, m: 0 }}>
                  <li>
                    Start by clicking <b>Add Block</b> below.
                  </li>
                  <li>
                    For nested conditions, add an <b>If / Then / Else</b> block,
                    and put another one inside it!
                  </li>
                  <li>
                    Use the Copy icon to copy a block and paste it in another
                    empty slot to save time.
                  </li>
                  <li>
                    Use <b>Math / Compare</b> to perform arithmatic operations
                    (e.g., +, -) and logical comparisons (e.g., &gt;, &lt;, =).
                  </li>
                  <li>
                    Use <b>Math Function</b> to apply advanced operations suach
                    as absolute, rounding, max, min.
                  </li>
                </Typography>
              </Alert>
            )}

            <ExpressionNode
              node={rootNode}
              availableVariables={availableVariables}
              onChange={setRootNode}
              onRemove={() => setRootNode(createNode("EMPTY"))}
              clipboard={clipboard}
              setClipboard={setClipboard}
            />
          </Box>
        </Paper>

        {/* OUTPUT SECTION */}
        <Paper
          elevation={0}
          sx={{
            overflow: "hidden",
            border: "1px solid",
            borderColor: "divider",
            bgcolor: "background.paper",
          }}
        >
          <Box
            sx={{
              p: 1.5,
              borderBottom: "1px solid",
              borderColor: "divider",
              bgcolor: (theme) => alpha(theme.palette.text.primary, 0.02),
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
            }}
          >
            <Typography
              variant="caption"
              fontWeight="bold"
              color="text.secondary"
              sx={{ textTransform: "uppercase", letterSpacing: 1 }}
            >
              Live Generated JEXL Payload
            </Typography>
            {!isComplete && rootNode.type !== "EMPTY" && (
              <Chip
                label="Incomplete formula (fill in the blanks)"
                size="small"
                color="warning"
                sx={{ height: 20, fontSize: 10 }}
              />
            )}
          </Box>
          <Box p={2}>
            <Typography
              variant="body2"
              sx={{
                fontFamily: "monospace",
                wordBreak: "break-all",
                color:
                  isComplete && rootNode.type !== "EMPTY"
                    ? "success.main"
                    : "text.disabled",
              }}
            >
              {jexlOutput === "___"
                ? "Start building to see output..."
                : jexlOutput}
            </Typography>
          </Box>
        </Paper>
      </Box>
    </Box>
  );
}
                                              
