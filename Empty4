const getVariableSearchText = (variableName, variable) => {
  if (!variable) return "";
  try {
    const parts = [variableName, variable.type, variable.table, variable.column];

    const filters = variable.filters || {};
    Object.entries(filters).forEach(([filterColumn, conditions]) => {
      parts.push(filterColumn);
      toSearchArray(conditions).forEach((cond) => {
        if (!cond) return;
        parts.push(cond.op);
        toSearchArray(cond.value).forEach((v) => parts.push(String(v)));
      });
    });

    return parts.filter(Boolean).join(" ");
  } catch {
    return "";
  }
};

