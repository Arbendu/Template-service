// Mirrors backend's TemplateDiffServiceImpl#buildCellKey() EXACTLY:
// prefer the NEW cell's id, then the OLD cell's id, then a positional fallback.
// This guarantees the OLD grid and NEW grid always resolve to the same diff key
// for the same logical cell, even if the old/new cell objects carry different ids.
const buildCellKeyMap = (oldRows, newRows) => {
  const map = new Map();
  const maxRows = Math.max(oldRows.length, newRows.length);

  for (let r = 0; r < maxRows; r++) {
    const oldCells = oldRows[r]?.cells || [];
    const newCells = newRows[r]?.cells || [];
    const maxCells = Math.max(oldCells.length, newCells.length);

    for (let c = 0; c < maxCells; c++) {
      const key = newCells[c]?.id || oldCells[c]?.id || `R${r}C${c}`;
      map.set(`${r}-${c}`, key);
    }
  }
  return map;
};










// replace gridInfo()

const gridInfo = useMemo(() => {
  if (!diffResponse) return { maxRows: 0, maxCols: 0, columns: [], rowsOld: [], rowsNew: [], cellKeyMap: new Map() };

  const oldTemplate = diffResponse.oldTemplate?.template?.reportData || {};
  const newTemplate = diffResponse.newTemplate?.template?.reportData || {};
  const columns = newTemplate?.columns || oldTemplate?.columns || [];

  const oldRowsRaw = oldTemplate?.rows || [];
  const newRowsRaw = newTemplate?.rows || [];

  let rowsOld = oldRowsRaw.map((r, i) => ({ ...r, _originalIndex: i }));
  let rowsNew = newRowsRaw.map((r, i) => ({ ...r, _originalIndex: i }));

  const cellKeyMap = buildCellKeyMap(oldRowsRaw, newRowsRaw);

  if (showChangesOnly && diffResponse.cellDiffs) {
    const isRowModified = (row) => {
      if (!row || !row.cells) return false;
      return row.cells.some((_, cIdx) => {
        const key = cellKeyMap.get(`${row._originalIndex}-${cIdx}`);
        return key && diffResponse.cellDiffs[key];
      });
    };
    rowsOld = rowsOld.filter(isRowModified);
    rowsNew = rowsNew.filter(isRowModified);
  }

  const maxR = Math.max(rowsOld.length, rowsNew.length);
  const maxC = Math.max(columns.length, ...rowsOld.map((r) => r.cells?.length || 0), ...rowsNew.map((r) => r.cells?.length || 0));

  return { maxRows: maxR, maxCols: maxC, columns, rowsOld, rowsNew, cellKeyMap };
}, [diffResponse, showChangesOnly]);





