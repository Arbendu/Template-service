// /CompareTemplate/DiffText
// ===============================================================================================================================================================================

import React, { memo } from "react";
import { Typography, Box } from "@mui/material";
import { alpha } from "@mui/material/styles";

export const DiffText = memo(({ value, otherValue, type }) => {
  if (value === null || value === undefined) {
    return null; 
  }

  // 1. Handle Arrays (e.g., Array of Filter Objects or Parameters)
  if (Array.isArray(value)) {
    const otherArr = Array.isArray(otherValue) ? otherValue : [];

    // Check if this is an array of objects (like FilterRules) or primitives (like VALUE list)
    const isObjectArray = value.length > 0 && typeof value[0] === "object" && value[0] !== null;

    // For objects, hide unchanged completely. For primitives, keep them for visual context.
    const itemsToRender = isObjectArray
      ? value.filter(item => {
          const itemStr = JSON.stringify(item);
          return !otherArr.some(otherItem => JSON.stringify(otherItem) === itemStr);
        })
      : value; 

    if (itemsToRender.length === 0) return null;

    return (
      <Box sx={{ display: "flex", flexDirection: "column", gap: 0.5 }}>
        {itemsToRender.map((item, idx) => {
          
          // A. Handle Object items inside the array
          if (typeof item === "object" && item !== null) {
            // Find the matching object from the other side based on unique identifiers
            // This prevents unchanged fields inside the object from being incorrectly crossed out
            let bestMatch = undefined;
            if (otherArr.length > 0) {
              const idKeys = ["dbColumn", "paramName", "cgl", "name", "id", "code"];
              for (let key of idKeys) {
                if (item[key]) {
                  bestMatch = otherArr.find(x => x[key] === item[key]);
                  if (bestMatch) break;
                }
              }
            }

            return (
              <Box key={idx} sx={{ pl: 1, borderLeft: (theme) => `2px solid ${theme.palette.divider}`, mb: 1 }}>
                <DiffText value={item} otherValue={bestMatch} type={type} />
              </Box>
            );
          }

          // B. Handle Primitive items inside the array (like the VALUE list)
          // Accurately diff individual primitive array items
          const isExplicitlyRemoved = type === "old" && !otherArr.includes(item);
          const isExplicitlyAdded = type === "new" && !otherArr.includes(item);

          return (
            <Typography
              key={idx}
              variant="body2"
              sx={(theme) => ({
                color: isExplicitlyRemoved ? "error.main" : isExplicitlyAdded ? "success.main" : "text.secondary",
                textDecoration: isExplicitlyRemoved ? "line-through" : "none",
                fontWeight: isExplicitlyAdded ? "bold" : "normal",
                bgcolor: isExplicitlyAdded
                  ? alpha(theme.palette.success.main, 0.15)
                  : isExplicitlyRemoved
                    ? alpha(theme.palette.error.main, 0.15)
                    : "transparent",
                px: 0.5, borderRadius: 1, display: "inline-block", mr: 0.5, mb: 0.5, fontSize: "0.75rem", fontFamily: "monospace",
              })}
            >
              • {item}
            </Typography>
          );
        })}
      </Box>
    );
  }

  // 2. Handle Objects (Recursively diff each key)
  if (typeof value === "object" && value !== null) {
    return (
      <Box sx={{ pl: 1, borderLeft: (theme) => `1px solid ${theme.palette.divider}` }}>
        {Object.entries(value).map(([key, val]) => {
          if (val === null || val === "" || (Array.isArray(val) && val.length === 0)) return null;

          return (
            <Box key={key} sx={{ mb: 1 }}>
              <Typography variant="caption" sx={{ fontWeight: "bold", color: "text.secondary", display: "block" }}>
                {key.toUpperCase()}:
              </Typography>
              <DiffText value={val} otherValue={otherValue ? otherValue[key] : undefined} type={type} />
            </Box>
          );
        })}
      </Box>
    );
  }

  // 3. Handle Primitives (Strings, Numbers)
  const isChanged = value !== otherValue;

  // SPECIAL FIX: Handle stringified arrays (e.g., "[1001, 1002]")
  if (
    isChanged &&
    typeof value === "string" && typeof otherValue === "string" &&
    value.trim().startsWith("[") && value.trim().endsWith("]") &&
    otherValue.trim().startsWith("[") && otherValue.trim().endsWith("]")
  ) {
    try {
      const valArr = JSON.parse(value);
      const otherArr = JSON.parse(otherValue);

      if (Array.isArray(valArr) && Array.isArray(otherArr)) {
        return (
          <Box sx={{ display: "flex", flexWrap: "wrap", gap: 0.5, alignItems: "center" }}>
            <Typography variant="body2" sx={{ fontFamily: "monospace" }}>[</Typography>
            {valArr.map((v, i) => {
              const existsInOther = otherArr.includes(v);
              const isRemoved = type === "old" && !existsInOther;
              const isAdded = type === "new" && !existsInOther;

              const isExplicitlyRemoved = type === "old" && !existsInOther;

              return (
                <Typography
                  key={i}
                  variant="body2"
                  component="span"
                  sx={(theme) => ({
                    color: isRemoved ? "error.main" : isAdded ? "success.main" : "text.primary",
                    textDecoration: isExplicitlyRemoved ? "line-through" : "none",
                    fontWeight: isAdded ? "bold" : "normal",
                    bgcolor: isAdded
                      ? alpha(theme.palette.success.main, 0.15)
                      : isRemoved
                        ? alpha(theme.palette.error.main, 0.15)
                        : "transparent",
                    px: 0.5, borderRadius: 1, fontSize: "0.8rem", fontFamily: "monospace"
                  })}
                >
                  {typeof v === 'string' ? `"${v}"` : v}{i < valArr.length - 1 ? "," : ""}
                </Typography>
              );
            })}
            <Typography variant="body2" sx={{ fontFamily: "monospace" }}>]</Typography>
          </Box>
        );
      }
    } catch (e) {
      // Fallback to standard primitive rendering
    }
  }

  // Properly define when a standard primitive string/number is explicitly removed
  const isExplicitlyRemoved = type === "old" && (otherValue === null || otherValue === undefined || otherValue === "");

  // Default rendering for normal strings and numbers
  return (
    <Typography
      variant="body2"
      sx={(theme) => ({
        color: isChanged
          ? type === "old"
            ? "error.main"
            : "success.main"
          : "text.primary",
        textDecoration: isExplicitlyRemoved ? "line-through" : "none",
        fontWeight: isChanged && type === "new" ? "bold" : "normal",
        wordBreak: "break-all",
      })}
    >
      {String(value)}
    </Typography>
  );
});

