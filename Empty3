    // Bidirectional Helper Methods
    // ========================================================================

    public void addParam(VariantParamDef param) {
        if (this.params == null) {
            this.params = new ArrayList<>();
        }
        this.params.add(param);
        param.setReportVariant(this); // Synchronizes the bidirectional link
    }

    public void addFilterRule(FilterRule rule) {
        if (this.filterRules == null) {
            this.filterRules = new ArrayList<>();
        }
        this.filterRules.add(rule);
        rule.setReportVariant(this); // Synchronizes the bidirectional link
    }

