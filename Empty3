     private void saveVariants(TemplatePayload payload, ReportTemplate template, TemplateRequest request, LocalDateTime now) {
        if (payload.getVariants() == null) {
            return;
        }

        for (VariantDto variantDto : payload.getVariants()) {
            // 1. Build the parent WITHOUT the children
            ReportVariant variant = ReportVariant.builder()
                    .templateId(template.getTemplateId())
                    .variantCode(variantDto.getVariantCode())
                    .variantName(variantDto.getVariantName())
                    .description(variantDto.getDescription())
                    .status(variantDto.getStatus())
                    .createdAt(now)
                    .createdBy(request.getCreatorId())
                    .updatedAt(now)
                    .updatedBy(request.getExecutorId())
                    .build();

            // 2. ABSOLUTELY CRITICAL: Force DB insertion immediately.
            // saveAndFlush guarantees savedVariant gets a real Database ID right now.
            ReportVariant savedVariant = variantRepository.saveAndFlush(variant);

            // 3. Build and explicitly save Params using their own repository
            if (variantDto.getParams() != null) {
                for (VariantParamDto paramDto : variantDto.getParams()) {
                    VariantParamDef param = VariantParamDef.builder()
                            .reportVariant(savedVariant) // Attach the fully persisted parent
                            .paramName(paramDto.getParamName())
                            .label(paramDto.getLabel())
                            .paramType(paramDto.getParamType())
                            .required(paramDto.isRequired() ? "Y" : "N")
                            .multiVal(paramDto.isMultiValued() ? "Y" : "N")
                            .uiHint(paramDto.getUiHint())
                            .validation(paramDto.getValidation())
                            .createdAt(now)
                            .build();
                    
                    // Bypass cascade: explicitly save the child directly
                    paramRepository.save(param); 
                }
            }

            // 4. Build and explicitly save Filter Rules using their own repository
            if (variantDto.getFilterRules() != null) {
                for (FilterRuleDto ruleDto : variantDto.getFilterRules()) {
                    FilterRule filterRule = FilterRule.builder()
                            .reportVariant(savedVariant) // Attach the fully persisted parent
                            .dbColumn(ruleDto.getDbColumn())
                            .operator(ruleDto.getOperator())
                            .paramName(ruleDto.getParamName())
                            .scopeType(ruleDto.getScopeType())
                            .scopeValue(ruleDto.getScopeValue())
                            .createdAt(now)
                            .build();
                    
                    // Bypass cascade: explicitly save the child directly
                    filterRuleRepository.save(filterRule); 
                }
            }
            
            // NOTE: Do NOT call variantRepository.save(savedVariant) again at the end.
            // Do NOT use the variant.addParam() helper method here.
            // The repositories have successfully handled everything in the exact right order.
        }
    }
   
   









    // ========================================================================
    // Bidirectional Helper Methods
    // ========================================================================

    public void addParam(VariantParamDef param) {
        if (this.params == null) {
            this.params = new ArrayList<>();
        }
        this.params.add(param);
        param.setReportVariant(this); // Synchronizes the bidirectional link
    }

    public void addFilterRule(FilterRule rule) {
        if (this.filterRules == null) {
            this.filterRules = new ArrayList<>();
        }
        this.filterRules.add(rule);
        rule.setReportVariant(this); // Synchronizes the bidirectional link
    }

