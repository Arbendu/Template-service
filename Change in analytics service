@PostMapping("/drill-down")
public ResponseEntity<?> executeDrillDown(
        @Valid @RequestBody DrillDownRequest request,
        @RequestHeader("Authorization") String token) {

    Integer roleId = jwtUtil.getUserRoleFromToken(token);

    // NEW: multi-headcode support. If HeadCode was sent as an "IN" filter (list of
    // codes) rather than the legacy single-value "EQUALS" filter, fan out per head
    // and return the aggregated multi-head shape instead of the single response.
    if (semanticDrillDownService.isMultiHeadRequest(request)) {
        MultiHeadDrillDownResponse response = semanticDrillDownService.executeMultiHeadDrillDown(request, roleId);
        return ResponseEntity.ok(response);
    }

    DrillDownResponse response = semanticDrillDownService.executeDrillDown(request, roleId);
    return ResponseEntity.ok(response);
}
