// --- ADD to SemanticDrillDownService ---

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Lazy;

@Slf4j
@Service
public class SemanticDrillDownService {

    private static final String HEAD_CODE_FIELD = "HeadCode";
    private static final String OPERATOR_IN = "IN";
    private static final int MAX_HEAD_CODES_PER_REQUEST = 50; // guardrail against abusive/huge batches

    // Self-injection: calling this.executeDrillDown(...) from within the same bean would
    // bypass the @Cacheable proxy entirely (Spring AOP limitation on self-invocation).
    // Routing through 'self' ensures each per-head call still hits/populates the cache.
    @Lazy
    @Autowired
    private SemanticDrillDownService self;

    // ... existing fields/constructor unchanged ...

    /**
     * True when the request's HeadCode filter uses "IN" (batch mode) instead of
     * the legacy single-value "EQUALS" operator. Used by the controller to route
     * to the multi-head path without breaking any existing single-head callers.
     */
    public boolean isMultiHeadRequest(DrillDownRequest request) {
        return request.filters().stream()
                .anyMatch(f -> HEAD_CODE_FIELD.equalsIgnoreCase(f.logicalField())
                        && OPERATOR_IN.equalsIgnoreCase(f.operator()));
    }

    /**
     * Executes a drill-down for MULTIPLE head codes in one call.
     * Decomposes the batch into one single-headcode request per code and delegates
     * to the existing (cached) executeDrillDown() for each, so results are cached
     * per head code exactly like today - a later single-head or different-batch
     * request for the same head code + filters is served from cache.
     *
     * A failure on one head code does not fail the whole batch; that head comes
     * back with status "FAILED" and empty data while the others still succeed.
     */
    public MultiHeadDrillDownResponse executeMultiHeadDrillDown(DrillDownRequest request, Integer roleId) {
        long batchStart = System.currentTimeMillis();

        List<String> headCodes = extractHeadCodes(request.filters());
        List<HeadDrillDownResult> results = new ArrayList<>(headCodes.size());

        for (String headCode : headCodes) {
            DrillDownRequest singleHeadRequest = withSingleHeadCodeFilter(request, headCode);
            try {
                DrillDownResponse singleResponse = self.executeDrillDown(singleHeadRequest, roleId);
                results.add(new HeadDrillDownResult(headCode, singleResponse.meta(), singleResponse.data()));
            } catch (Exception ex) {
                log.error("DrillDown failed for headCode [{}] in batch for view [{}]",
                        headCode, request.viewCode(), ex);
                Meta failedMeta = new Meta("FAILED", request.dimensions().getFirst(), 0, 0L);
                results.add(new HeadDrillDownResult(headCode, failedMeta, Collections.emptyList()));
            }
        }

        long totalTime = System.currentTimeMillis() - batchStart;
        String overallStatus = results.stream().anyMatch(r -> "FAILED".equals(r.headMeta().status()))
                ? "PARTIAL_SUCCESS"
                : "SUCCESS";

        return new MultiHeadDrillDownResponse(
                new MultiHeadMeta(overallStatus, totalTime, headCodes.size()),
                results
        );
    }

    /** Pulls the HeadCode "IN" filter out of the request and validates it. */
    private List<String> extractHeadCodes(List<FilterDto> filters) {
        FilterDto headCodeFilter = filters.stream()
                .filter(f -> HEAD_CODE_FIELD.equalsIgnoreCase(f.logicalField())
                        && OPERATOR_IN.equalsIgnoreCase(f.operator()))
                .findFirst()
                .orElseThrow(() -> new IllegalArgumentException(
                        "A HeadCode filter with operator 'IN' is required for multi-head drill-down."));

        if (!(headCodeFilter.value() instanceof List<?> rawList) || rawList.isEmpty()) {
            throw new IllegalArgumentException("HeadCode 'IN' filter must supply a non-empty list of head codes.");
        }
        if (rawList.size() > MAX_HEAD_CODES_PER_REQUEST) {
            throw new IllegalArgumentException(
                    "Too many head codes requested in a single call (max " + MAX_HEAD_CODES_PER_REQUEST + ").");
        }

        List<String> headCodes = new ArrayList<>(rawList.size());
        for (Object o : rawList) {
            String code = String.valueOf(o).trim();
            if (code.isEmpty()) {
                throw new IllegalArgumentException("HeadCode list contains a blank value.");
            }
            headCodes.add(code);
        }
        return headCodes;
    }

    /**
     * Returns a copy of the request where the multi-value HeadCode "IN" filter is
     * replaced by a single-value "EQUALS" filter for one head code - the exact shape
     * the existing ARRAY_CONTAINS SQL logic in DruidQueryBuilder already handles.
     * DruidQueryBuilder itself needs zero changes.
     */
    private DrillDownRequest withSingleHeadCodeFilter(DrillDownRequest original, String headCode) {
        List<FilterDto> newFilters = new ArrayList<>(original.filters().size());
        for (FilterDto f : original.filters()) {
            if (HEAD_CODE_FIELD.equalsIgnoreCase(f.logicalField()) && OPERATOR_IN.equalsIgnoreCase(f.operator())) {
                newFilters.add(new FilterDto(f.logicalField(), "EQUALS", headCode));
            } else {
                newFilters.add(f);
            }
        }
        return new DrillDownRequest(original.viewCode(), original.dimensions(), original.metrics(), newFilters);
    }

    // ... existing executeDrillDown(), validateAccess(), etc. all stay exactly as-is ...
}










//controller/AnalyticsController.java

@PostMapping("/drill-down")
public ResponseEntity<?> executeDrillDown(
        @Valid @RequestBody DrillDownRequest request,
        @RequestHeader("Authorization") String token) {

    Integer roleId = jwtUtil.getUserRoleFromToken(token);

    // NEW: multi-headcode support. If HeadCode was sent as an "IN" filter (list of
    // codes) rather than the legacy single-value "EQUALS" filter, fan out per head
    // and return the aggregated multi-head shape instead of the single response.
    if (semanticDrillDownService.isMultiHeadRequest(request)) {
        MultiHeadDrillDownResponse response = semanticDrillDownService.executeMultiHeadDrillDown(request, roleId);
        return ResponseEntity.ok(response);
    }

    DrillDownResponse response = semanticDrillDownService.executeDrillDown(request, roleId);
    return ResponseEntity.ok(response);
}
