@PostMapping("/drill-down")
public ResponseEntity<?> executeDrillDown(
        @Valid @RequestBody DrillDownRequest request,
        @RequestHeader("Authorization") String token) {

    Integer roleId = jwtUtil.getUserRoleFromToken(token);

    // NEW: multi-headcode support. If HeadCode was sent as an "IN" filter (list of
    // codes) rather than the legacy single-value "EQUALS" filter, fan out per head
    // and return the aggregated multi-head shape instead of the single response.
    if (semanticDrillDownService.isMultiHeadRequest(request)) {
        MultiHeadDrillDownResponse response = semanticDrillDownService.executeMultiHeadDrillDown(request, roleId);
        return ResponseEntity.ok(response);
    }

    DrillDownResponse response = semanticDrillDownService.executeDrillDown(request, roleId);
    return ResponseEntity.ok(response);
}












export const fetchAnalyticsData = async (callApi, showSnackBar, payload) => {
  try {
    console.log("Drill-down payload: ", payload);
    const responseData = await callApi(
      "/AS/analytics/drill-down",
      payload,
      "POST",
    );

    const result = responseData?.data;

    // CHANGED: multi-headcode responses shape "data" differently -
    // each entry is { headCode, headMeta, headData }, not a flat row with `.name`.
    // Sorting those with the old `.name` comparator would throw/produce garbage.
    const isMultiHead = Boolean(responseData?.meta?.headCodeCount);

    if (isMultiHead) {
      // Sort each head's own rows independently; leave the per-head grouping intact
      // for the caller to render (see note below on fetchInitialData/fetchChildrenData).
      return (result || []).map((headEntry) => ({
        ...headEntry,
        headData: [...(headEntry.headData || [])].sort((a, b) =>
          (a.name || "").localeCompare(b.name || ""),
        ),
      }));
    }

    const sortedList = [...(result || [])].sort((a, b) =>
      (a.name || "").localeCompare(b.name || ""),
    );
    return sortedList;
  } catch (error) {
    console.error("Error fetching analytics data:", error);
    showSnackBar("Error: " + error?.title || "Failed to fetch data", "error");
  }
};

