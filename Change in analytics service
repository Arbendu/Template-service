export const fetchHeads = async (callApi, reportName, search) => {
  if (!search || search.length < 2) return [];
  try {
    const response = await callApi(
      `/AS/analytics/heads/search?reportName=${reportName}&search=${search}`,
      {},
      "GET",
    );
    return Array.isArray(response) ? response : response?.data || [];
  } catch (error) {
    console.error("Error fetching heads:", error);
    return [];
  }
};

const formatDateToDDMMYYYY = (dateString) => {
  if (!dateString) return "";
  const [year, month, day] = dateString.split("-");
  return `${day}-${month}-${year}`;
};

// Base payload filter builder
const buildBaseFilters = (appliedFilters) => {
  const formattedDate = formatDateToDDMMYYYY(appliedFilters.reportDate);

  // CHANGED: pull all selected head codes, not just the first.
  const headCodes = (appliedFilters.heads || [])
    .map((h) => h?.headCode)
    .filter(Boolean);

  const filters = [
    {
      logicalField: "ReportDate",
      operator: "EQUALS",
      value: formattedDate,
    },
    // CHANGED: single head -> legacy "EQUALS" (unchanged, single-head response shape).
    // Multiple heads -> "IN" with the full list; backend fans this out per head and
    // returns the multi-head response shape (meta.headCodeCount + per-head entries).
    headCodes.length > 1
      ? {
          logicalField: "HeadCode",
          operator: "IN",
          value: headCodes,
        }
      : {
          logicalField: "HeadCode",
          operator: "EQUALS",
          value: headCodes[0],
        },
  ];

  // Inject Circle or Branch filter if an entity is selected and the view requires it — unchanged
  if (appliedFilters.entityCode) {
    const isCircleScope = appliedFilters.viewCode.includes("CIRCLE");
    const isBranchScope = appliedFilters.viewCode.includes("BRANCH");

    if (isCircleScope) {
      filters.push({
        logicalField: "Circle",
        operator: "EQUALS",
        value: appliedFilters.entityCode,
      });
    } else if (isBranchScope) {
      filters.push({
        logicalField: "BranchCode",
        operator: "EQUALS",
        value: appliedFilters.entityCode,
      });
    }
  }

  return filters;
};

