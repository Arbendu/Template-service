import { useState, useMemo, useCallback, useEffect, useRef } from "react";
import InputBase from "@mui/material/InputBase";
import IconButton from "@mui/material/IconButton";
import Typography from "@mui/material/Typography";
import Box from "@mui/material/Box";
import Tooltip from "@mui/material/Tooltip";
import SearchIcon from "@mui/icons-material/Search";
import CloseIcon from "@mui/icons-material/Close";
import KeyboardArrowUpIcon from "@mui/icons-material/KeyboardArrowUp";
import KeyboardArrowDownIcon from "@mui/icons-material/KeyboardArrowDown";
import { useAppDispatch, useAppSelector } from "../../store";
import { setSelectedCell } from "../../store/templateSlice";
import {
  selectRowOrder,
  selectRowsEntities,
  selectCellsEntities,
} from "../../store/selectors";

const DEBOUNCE_MS = 250;
const COLLAPSED_WIDTH = 36;
const EXPANDED_WIDTH = 360;

const escapeRegExp = (str) => str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

const getCellSearchText = (cell) => {
  if (!cell) return "";
  if (cell.type === "TEXT") return cell.value || "";
  if (cell.type === "FORMULA") return cell.expression || "";
  if (cell.type?.startsWith("DB_")) {
    return `${cell.source?.table || ""}.${cell.source?.column || ""}`;
  }
  return "";
};

const makeMatcher = (query, matchCase, matchExactWord) => {
  if (matchExactWord) {
    const re = new RegExp(`\\b${escapeRegExp(query)}\\b`, matchCase ? "" : "i");
    return (text) => !!text && re.test(text);
  }
  if (matchCase) {
    return (text) => !!text && text.includes(query);
  }
  const q = query.toLowerCase();
  return (text) => !!text && text.toLowerCase().includes(q);
};

const findRowMatch = (row, cellsById, testText) => {
  if (testText(row.id)) {
    return { rowId: row.id, cellId: row.cellIds?.[0] || null };
  }
  if (row.rowType === "DYNAMIC") {
    return testText(row.dynamicConfig?.table)
      ? { rowId: row.id, cellId: null }
      : null;
  }
  const cellIds = row.cellIds || [];
  for (let i = 0; i < cellIds.length; i++) {
    const cell = cellsById[cellIds[i]];
    if (!cell) continue;
    if (testText(getCellSearchText(cell)) || testText(cell.id)) {
      return { rowId: row.id, cellId: cell.id };
    }
  }
  return null;
};

// Flat icon button: no circular ripple/hover background.
const FlatIconButton = ({ children, sx, ...props }) => (
  <IconButton
    size="small"
    disableRipple
    disableFocusRipple
    sx={{
      p: 0.25,
      bgcolor: "transparent",
      color: "primary.main",
      borderRadius: "50%",
      "&:hover": { bgcolor: "primary.info", color: "primary.dark" },
      ...sx,
    }}
    {...props}
  >
    {children}
  </IconButton>
);

// VSCode-style "Aa" / "ab" inline toggle.
const OptionToggle = ({ label, underline, active, onClick, title }) => (
  <Tooltip title={title}>
    <Box
      onClick={onClick}
      sx={{
        width: 22,
        height: 22,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        borderRadius: "3px",
        cursor: "pointer",
        fontSize: "0.7rem",
        fontWeight: 600,
        lineHeight: 1,
        color: active ? "primary.main" : "text.secondary",
        bgcolor: active ? "action.selected" : "transparent",
        border: active ? "1px solid" : "1px solid transparent",
        borderColor: active ? "primary.main" : "transparent",
        textDecoration: underline ? "underline" : "none",
        "&:hover": { bgcolor: active ? "action.selected" : "action.hover" },
      }}
    >
      {label}
    </Box>
  </Tooltip>
);

export const ReportSearchBar = () => {
  const dispatch = useAppDispatch();
  const rowOrder = useAppSelector(selectRowOrder);
  const rowsById = useAppSelector(selectRowsEntities);
  const cellsById = useAppSelector(selectCellsEntities);

  const [expanded, setExpanded] = useState(false);
  const [inputValue, setInputValue] = useState("");
  const [query, setQuery] = useState("");
  const [matchCase, setMatchCase] = useState(false);
  const [matchExactWord, setMatchExactWord] = useState(false);
  const [currentIndex, setCurrentIndex] = useState(0);

  const inputRef = useRef(null);
  const containerRef = useRef(null);
  const lastNavigatedKeyRef = useRef(null);

  useEffect(() => {
    const t = setTimeout(() => setQuery(inputValue.trim()), DEBOUNCE_MS);
    return () => clearTimeout(t);
  }, [inputValue]);

  const collapseIfEmpty = useCallback(() => {
    if (!inputValue.trim()) setExpanded(false);
  }, [inputValue]);

  const handleExpand = () => {
    setExpanded(true);
    requestAnimationFrame(() => inputRef.current?.focus());
  };

  // Collapse on outside click when there's no active query.
  useEffect(() => {
    if (!expanded) return;
    const handleClickAway = (e) => {
      if (containerRef.current && !containerRef.current.contains(e.target)) {
        collapseIfEmpty();
      }
    };
    document.addEventListener("mousedown", handleClickAway);
    return () => document.removeEventListener("mousedown", handleClickAway);
  }, [expanded, collapseIfEmpty]);

  // Ctrl/Cmd+F opens & focuses; Escape closes.
  useEffect(() => {
    const handleKeyDown = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "f") {
        e.preventDefault();
        handleExpand();
        inputRef.current?.select();
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, []);

  const matches = useMemo(() => {
    if (!query) return [];
    const testText = makeMatcher(query, matchCase, matchExactWord);
    const result = [];
    for (let i = 0; i < rowOrder.length; i++) {
      const row = rowsById[rowOrder[i]];
      if (!row) continue;
      const match = findRowMatch(row, cellsById, testText);
      if (match) result.push(match);
    }
    return result;
  }, [rowOrder, rowsById, cellsById, query, matchCase, matchExactWord]);

  const navigateToIndex = useCallback(
    (idx) => {
      const match = matches[idx];
      if (!match) return;
      const key = `${match.rowId}:${match.cellId || ""}`;
      if (lastNavigatedKeyRef.current === key) return;
      lastNavigatedKeyRef.current = key;

      dispatch(
        setSelectedCell({ rowId: match.rowId, cellId: match.cellId || "" }),
      );
      window.dispatchEvent(
        new CustomEvent("report-search-navigate", {
          detail: { rowId: match.rowId },
        }),
      );
    },
    [matches, dispatch],
  );

  // Re-jump only when the search itself changes, not on every matches recompute.
  useEffect(() => {
    setCurrentIndex(0);
    lastNavigatedKeyRef.current = null;
    if (matches.length > 0) navigateToIndex(0);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [query, matchCase, matchExactWord]);

  const handleNext = useCallback(() => {
    if (matches.length === 0) return;
    const next = (currentIndex + 1) % matches.length;
    setCurrentIndex(next);
    navigateToIndex(next);
  }, [matches, currentIndex, navigateToIndex]);

  const handlePrev = useCallback(() => {
    if (matches.length === 0) return;
    const prev = (currentIndex - 1 + matches.length) % matches.length;
    setCurrentIndex(prev);
    navigateToIndex(prev);
  }, [matches, currentIndex, navigateToIndex]);

  const handleKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      e.shiftKey ? handlePrev() : handleNext();
    } else if (e.key === "Escape") {
      handleClear();
      inputRef.current?.blur();
      setExpanded(false);
    }
  };

  const handleClear = () => {
    setInputValue("");
    setQuery("");
    setCurrentIndex(0);
  };

  const hasQuery = inputValue.trim().length > 0;
  const noResults = query.length > 0 && matches.length === 0;

  return (
    <Box
      ref={containerRef}
      sx={{
        display: "flex",
        alignItems: "center",
        height: 36,
        width: expanded ? EXPANDED_WIDTH : COLLAPSED_WIDTH,
        transition: "width 220ms cubic-bezier(0.4, 0, 0.2, 1)",
        overflow: "hidden",
        borderRadius: 1,
        border: "1px solid",
        borderColor: expanded ? "divider" : "transparent",
        bgcolor: expanded ? "background.paper" : "transparent",
        px: expanded ? 1 : 0,
        color: "primary.main"
      }}
    >
      <FlatIconButton
        onClick={expanded ? handleNext : handleExpand}
        sx={{ flexShrink: 0 }}
      >
        <SearchIcon fontSize="small" color={noResults ? "error" : "action"} />
      </FlatIconButton>

      <InputBase
        inputRef={inputRef}
        placeholder="Search rows..."
        value={inputValue}
        onChange={(e) => setInputValue(e.target.value)}
        onKeyDown={handleKeyDown}
        sx={{
          ml: 1,
          flex: 1,
          fontSize: "0.85rem",
          minWidth: 0,
          opacity: expanded ? 1 : 0,
          transition: "opacity 150ms ease 80ms",
        }}
      />

      <Box
        sx={{
          display: "flex",
          alignItems: "center",
          gap: 0.5,
          flexShrink: 0,
          whiteSpace: "nowrap",
        }}
      >
        {hasQuery && (
          <Typography
            variant="caption"
            color={noResults ? "error" : "text.secondary"}
            sx={{ minWidth: 40, textAlign: "center" }}
          >
            {query.length === 0
              ? "…"
              : noResults
                ? "No results"
                : `${currentIndex + 1} of ${matches.length}`}
          </Typography>
        )}

        <OptionToggle
          label="Aa"
          active={matchCase}
          onClick={() => setMatchCase((v) => !v)}
          title="Match case"
        />
        <OptionToggle
          label="ab"
          underline
          active={matchExactWord}
          onClick={() => setMatchExactWord((v) => !v)}
          title="Match whole word"
        />

        <Box sx={{ display: "flex", flexDirection: "column", ml: 0.5 }}>
          <FlatIconButton
            onClick={handlePrev}
            disabled={matches.length === 0}
            sx={{ p: 0 }}
          >
            <KeyboardArrowUpIcon sx={{ fontSize: "1rem" }} />
          </FlatIconButton>
          <FlatIconButton
            onClick={handleNext}
            disabled={matches.length === 0}
            sx={{ p: 0 }}
          >
            <KeyboardArrowDownIcon sx={{ fontSize: "1rem" }} />
          </FlatIconButton>
        </Box>

        <FlatIconButton
          onClick={() => {
            handleClear();
            setExpanded(false);
          }}
        >
          <CloseIcon fontSize="small" />
        </FlatIconButton>
      </Box>
    </Box>
  );
};
