      prevProps.formulaMode === nextProps.formulaMode &&
      prevProps.isHidden === nextProps.isHidden &&
      prevProps.columnWidths === nextProps.columnWidths &&
      prevProps.columnAlign === nextProps.columnAlign
    );
  },
);

