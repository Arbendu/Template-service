        </MenuItem>
        {/* <MenuItem onClick={() => openAddRowDialog("SEPARATOR", insertAtIndex)}>Separator</MenuItem> */}
        <MenuItem onClick={() => openAddRowDialog("DYNAMIC", insertAtIndex)}>
